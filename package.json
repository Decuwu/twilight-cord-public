{
  "name": "twilight-cord",
  "version": "1.25.1",
  "private": true,
  "bin": "installer.js",
  "scripts": {
    "build": "pkg . --targets node24-win-x64 --output dist/twilight-cord-launcher.exe",
    "scrub": "node tools/scrub-check.js .",
    "public": "node tools/make-public.js Decuwu/twilight-cord-public"
  },
  "pkg": {
    "assets": [
      "core.js",
      "debug.js",
      "twilight.js",
      "manifest.json",
      "config.json",
      "plugins/*",
      "assets/*",
      "themes/*"
    ]
  }
}
